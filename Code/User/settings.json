{
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell"
  },
  "arduino.useArduinoCli": true,
  "chat.fontFamily": "Moralerspace Neon HW",
  "chat.fontSize": 14,
  "editor.codeLens": false,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.fontFamily": "Moralerspace Neon HW",
  "editor.formatOnSaveMode": "file",
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "extensions.ignoreRecommendations": true,
  "files.associations": {
    "*.toml": "ini",
    "*.ino": "cpp"
  },
  "editor.formatOnSave": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "never",
  "git.suggestSmartCommit": false,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "oxc.path.node": "C:\\Program Files\\nodejs\\node.exe",
  "settingsSync.ignoredExtensions": ["ms-vscode.js-debug-companion"],
  "terminal.integrated.commandsToSkipShell": ["matlab.interrupt"],
  "terminal.integrated.defaultLocation": "view",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.fontFamily": "Moralerspace Neon HW",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.tabs.defaultIcon": "terminal-linux",
  "vsicons.dontShowNewVersionMessage": true,
  "workbench.iconTheme": "vscode-icons",
  "workbench.colorTheme": "GitHub Dark Colorblind (Beta)"
}
